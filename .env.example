# CivicTrust Environment Configuration

# Security & Authentication
SECRET_KEY=civictrust_demo_super_secret_jwt_key_2026_academic_demo
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default for standalone local demo: SQLite
DATABASE_URL=sqlite:///./civictrust.db
# PostgreSQL Docker alternative:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/civictrust

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=civictrust

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
